{
    "version": 2,
    "framework": null,
    "installCommand": "npm ci",
    "buildCommand": "npm run vercel-build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "excludeFiles": "{public/videos/**,public/images/**,node_modules/**,tests/**,storage/**,database/**,resources/js/**,resources/css/**,.github/**,vendor/**/tests/**,vendor/**/docs/**}",
            "memory": 1024,
            "maxDuration": 30
        }
    },
    "routes": [
        { "src": "/build/(.*)", "dest": "/public/build/$1" },
        { "src": "/images/(.*)", "dest": "/public/images/$1" },
        { "src": "/videos/(.*)", "dest": "/public/videos/$1" },
        { "src": "/favicon.svg", "dest": "/public/favicon.svg" },
        { "src": "/robots.txt", "dest": "/public/robots.txt" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    },
    "env": {
        "LOG_CHANNEL": "stderr",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "SESSION_DRIVER": "cookie",
        "CACHE_STORE": "array",
        "QUEUE_CONNECTION": "sync"
    }
}
