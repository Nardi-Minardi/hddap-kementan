{
    "version": 2,
    "installCommand": "npm ci",
    "buildCommand": "npm run vercel-build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "excludeFiles": "public/videos/**,public/images/**,node_modules/**,tests/**,storage/**,database/**,resources/js/**,resources/css/**",
            "memory": 1024,
            "maxDuration": 10
        }
    },
    "routes": [
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "LOG_CHANNEL": "stderr",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "SESSION_DRIVER": "cookie",
        "CACHE_STORE": "array",
        "QUEUE_CONNECTION": "sync"
    }
}
