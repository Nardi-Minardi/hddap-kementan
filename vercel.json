{
    "version": 2,
    "installCommand": "npm ci",
    "buildCommand": "npm run vercel-build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "excludeFiles": "public/videos/**",
            "memory": 1024,
            "maxDuration": 10
        }
    },
    "routes": [
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "LOG_CHANNEL": "stderr",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "SESSION_DRIVER": "cookie",
        "CACHE_STORE": "array",
        "QUEUE_CONNECTION": "sync"
    }
}
