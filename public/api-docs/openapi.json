                          "kelas_lereng": "Datar",
                          "kemiringan": "0-8%",
                          "fungsi_kws_hutan": "Bukan Kawasan Hutan",
                          "tahap": "1",
                          "kode_poktan": 12,
                          "kode_kota": 3201,
                          "foto_lahan": null,
                          "poktan": {
                            "id": 12,
                            "nama_poktan": "Kelompok Tani Makmur",
                            "kode_cluster": 3
                          },
                          "kab_kota": {
                            "code": "3201",
                            "name": "Kab. Bogor"
                          },
                          "created_at": "2026-06-25 10:00:00",
                          "updated_at": "2026-06-25 10:00:00"
                        }
                      ],
                      "meta": {
                        "total": 150,
                        "limit": 10,
                        "offset": 0,
                        "order_by": "id",
                        "order_direction": "asc",
                        "search": null,
