                          "dukungan_proyek": null
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validasi gagal — parameter request tidak memenuhi aturan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/wilayah": {
      "get": {
        "summary": "Wilayah Lengkap",
        "description": "Data wilayah administratif: provinsi → kab/kota → kecamatan → kelurahan/desa. Default format **nested** (hierarki lengkap). Gunakan `format=flat` + `level` untuk daftar per level dengan pagination.",
        "operationId": "getWilayah",
        "tags": ["Wilayah"],
        "parameters": [
          { "name": "format", "in": "query", "schema": { "type": "string", "enum": ["nested", "flat"], "default": "nested" } },
          { "name": "level", "in": "query", "schema": { "type": "string", "enum": ["provinsi", "kab_kota", "kecamatan", "kel_des"], "nullable": true } },
          { "name": "provinsi_code", "in": "query", "schema": { "type": "string", "nullable": true } },
          { "name": "kab_kota_code", "in": "query", "schema": { "type": "string", "nullable": true } },
          { "name": "kecamatan_code", "in": "query", "schema": { "type": "string", "nullable": true } },
          { "name": "search", "in": "query", "schema": { "type": "string", "maxLength": 255, "nullable": true } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } },
          { "name": "order_by", "in": "query", "schema": { "type": "string", "default": "code", "enum": ["code", "name"] } },
          { "name": "order_direction", "in": "query", "schema": { "type": "string", "default": "asc", "enum": ["asc", "desc"] } }
        ],
        "responses": {
          "200": { "description": "Berhasil", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WilayahResponse" } } } },
          "422": { "description": "Validasi gagal", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" } } } }
        }
      }
    },
    "/poktan": {
      "get": {
        "summary": "List Poktan",
        "description": "Daftar kelompok tani (`m_poktan`) dengan relasi cluster dan kab/kota.",
        "operationId": "getPoktanList",
        "tags": ["Poktan"],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string", "maxLength": 255, "nullable": true } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } },
          { "name": "order_by", "in": "query", "schema": { "type": "string", "default": "id", "enum": ["id", "nama_poktan", "ketua", "telp", "kode_kota", "kode_cluster", "gender_lp"] } },
          { "name": "order_direction", "in": "query", "schema": { "type": "string", "default": "asc", "enum": ["asc", "desc"] } },
          { "name": "kode_kota", "in": "query", "schema": { "type": "integer", "nullable": true } },
          { "name": "kode_cluster", "in": "query", "schema": { "type": "integer", "nullable": true } }
        ],
        "responses": {
          "200": { "description": "Berhasil", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PoktanListResponse" } } } },
          "422": { "description": "Validasi gagal", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" } } } }
        }
      }
    },
    "/cluster": {
      "get": {
        "summary": "List Cluster",
        "description": "Daftar cluster petani (`m_cluster`) dengan relasi komoditas dan kab/kota.",
        "operationId": "getClusterList",
        "tags": ["Cluster"],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string", "maxLength": 255, "nullable": true } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } },
          { "name": "order_by", "in": "query", "schema": { "type": "string", "default": "id", "enum": ["id", "nama_cluster", "nama_kota", "kode_kota", "kode_kumoditas"] } },
          { "name": "order_direction", "in": "query", "schema": { "type": "string", "default": "asc", "enum": ["asc", "desc"] } },
          { "name": "kode_kota", "in": "query", "schema": { "type": "integer", "nullable": true } },
          { "name": "kode_kumoditas", "in": "query", "schema": { "type": "integer", "nullable": true } }
        ],
        "responses": {
          "200": { "description": "Berhasil", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClusterListResponse" } } } },
          "422": { "description": "Validasi gagal", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" } } } }
        }
      }
    },
    "/kumoditas": {
      "get": {
        "summary": "List Kumoditas",
        "description": "Daftar komoditas (`m_kumoditas`) dengan relasi jenis komoditas.",
        "operationId": "getKumoditasList",
        "tags": ["Kumoditas"],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string", "maxLength": 255, "nullable": true } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } },
          { "name": "order_by", "in": "query", "schema": { "type": "string", "default": "id", "enum": ["id", "kumoditas", "kodejns", "keterangan"] } },
          { "name": "order_direction", "in": "query", "schema": { "type": "string", "default": "asc", "enum": ["asc", "desc"] } },
          { "name": "kodejns", "in": "query", "schema": { "type": "integer", "nullable": true } }
        ],
        "responses": {
          "200": { "description": "Berhasil", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/KumoditasListResponse" } } } },
          "422": { "description": "Validasi gagal", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LogframeItem": {
        "type": "object",
        "description": "Satu record indikator logframe",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID unik record",
            "example": 1
          },
          "tingkat": {
            "type": "string",
            "nullable": true,
            "description": "Tingkat indikator (mis. Jangkauan, Outcome)",
            "example": "Jangkauan"
          },
          "nama_indikator": {
            "type": "string",
            "nullable": true,
            "description": "Nama indikator logframe",
            "example": "Jumlah petani yang didukung oleh proyek"
          },
          "definisi_indikator": {
            "type": "string",
            "nullable": true,
            "description": "Definisi operasional indikator"
          },
          "nilai_dasar": {
            "type": "string",
            "nullable": true,
            "description": "Nilai dasar (baseline)",
            "example": "0"
          },
          "target_pertengahan_proyek": {
            "type": "string",
            "nullable": true,
            "description": "Target pada pertengahan proyek"
          },
          "target_akhir_proyek": {
            "type": "string",
            "nullable": true,
            "description": "Target pada akhir proyek"
          },
          "realisasi": {
            "type": "string",
            "nullable": true,
            "description": "Nilai realisasi capaian"
          },
          "component": {
            "type": "string",
            "nullable": true,
            "description": "Komponen indikator"
          },
          "sumber_data": {
            "type": "string",
            "nullable": true,
            "description": "Sumber data indikator"
          },
          "data_yg_dikumpulkan": {
            "type": "string",
            "nullable": true,
            "description": "Data yang dikumpulkan"
          },
          "created_at": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Tanggal dibuat (format YYYY-MM-DD)",
            "example": "2026-06-25"
          },
          "updated_at": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Tanggal diperbarui (format YYYY-MM-DD)",
            "example": "2026-06-25"
          }
        }
      },
      "LogframeListMeta": {
        "type": "object",
        "description": "Metadata pagination dan filter",
        "properties": {
          "total": {
            "type": "integer",
            "description": "Total record yang cocok dengan filter",
            "example": 7
          },
          "limit": {
            "type": "integer",
            "description": "Limit yang digunakan",
            "example": 10
          },
          "offset": {
            "type": "integer",
            "description": "Offset yang digunakan",
            "example": 0
          },
          "order_by": {
            "type": "string",
            "description": "Kolom sort aktif",
            "example": "id"
          },
          "order_direction": {
            "type": "string",
            "enum": ["asc", "desc"],
            "description": "Arah sort aktif",
            "example": "asc"
          },
          "search": {
            "type": "string",
            "nullable": true,
            "description": "Kata kunci pencarian aktif",
            "example": null
          }
        }
      },
      "LogframeListResponse": {
        "type": "object",
        "description": "Response standar daftar logframe",
        "properties": {
          "status_code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "Success"
          },
          "data": {
            "type": "array",
            "description": "Array record logframe",
            "items": {
              "$ref": "#/components/schemas/LogframeItem"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/LogframeListMeta"
          }
        }
      },
      "PetaniKabKota": {
        "type": "object",
        "nullable": true,
        "properties": {
          "code": { "type": "string", "example": "3201" },
          "name": { "type": "string", "example": "Kab. Bogor" }
        }
      },
      "PetaniPoktan": {
        "type": "object",
        "nullable": true,
        "properties": {
          "id": { "type": "integer", "example": 12 },
          "nama_poktan": { "type": "string", "example": "Kelompok Tani Makmur" },
          "kode_cluster": { "type": "integer", "example": 3 }
        }
      },
      "PetaniItem": {
        "type": "object",
        "description": "Satu record petani dari tabel m_petani",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "nama_petani": { "type": "string", "example": "Budi Santoso" },
          "nik_petani": { "type": "string", "nullable": true, "example": "3201010101010001" },
          "no_hp_petani": { "type": "string", "nullable": true, "example": "081234567890" },
          "gender_petani": { "type": "string", "nullable": true, "enum": ["L", "P"], "example": "L" },
          "usia_petani": { "type": "integer", "nullable": true, "example": 35 },
          "difabel": { "type": "boolean", "example": false },
          "alamat_petani": { "type": "string", "nullable": true },
          "jmlah_petani": { "type": "integer", "nullable": true, "example": 1 },
          "luas_lahan_ha": { "type": "number", "format": "float", "nullable": true, "example": 0.5 },
          "latitude": { "type": "number", "format": "float", "nullable": true, "example": -6.914744 },
          "longitude": { "type": "number", "format": "float", "nullable": true, "example": 107.60981 },
          "kelas_lereng": { "type": "string", "nullable": true },
          "kemiringan": { "type": "string", "nullable": true },
          "fungsi_kws_hutan": { "type": "string", "nullable": true },
          "tahap": { "type": "string", "nullable": true, "example": "1" },
          "kode_poktan": { "type": "integer", "nullable": true, "example": 12 },
          "kode_kota": { "type": "integer", "nullable": true, "example": 3201 },
