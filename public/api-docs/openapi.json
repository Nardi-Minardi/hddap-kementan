{
  "openapi": "3.0.3",
  "info": {
    "title": "HDDAP Kementan API",
    "version": "1.0.0",
    "description": "Dokumentasi API HDDAP — Kementerian Pertanian RI.\n\n**Base URL:** `/api`\n\n**Format response:** `status_code`, `message`, `data`, `meta` (snake_case).\n\n**Pagination:** `limit` (default 10, maks 100), `offset` (default 0).\n\n**Sorting & search:** `search`, `order_by` (default `id`), `order_direction` (`asc` / `desc`).\n\n**Error 422:** `meta.errors` berisi detail validasi."
  },
  "servers": [
    {
      "url": "/api",
      "description": "Server API HDDAP"
    }
  ],
  "paths": {
    "/logframe": {
      "get": {
        "summary": "List Logframe",
        "description": "Mengembalikan daftar indikator logframe. Mendukung pencarian, pagination, dan sorting.",
        "operationId": "getLogframeList",
        "tags": ["Logframe"],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Kata kunci pencarian di semua kolom teks logframe",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255,
              "nullable": true
            },
            "example": "petani"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Jumlah data per halaman (maksimum 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            },
            "example": 5
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Posisi awal data untuk pagination",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "example": 0
          },
          {
            "name": "order_by",
            "in": "query",
            "description": "Kolom pengurutan data",
            "required": false,
            "schema": {
              "type": "string",
              "default": "id",
              "enum": [
                "id",
                "tingkat",
                "nama_indikator",
                "definisi_indikator",
                "nilai_dasar",
                "target_pertengahan_proyek",
                "target_akhir_proyek",
                "realisasi",
                "created_at",
                "updated_at"
              ]
            },
            "example": "id"
          },
          {
            "name": "order_direction",
            "in": "query",
            "description": "Arah pengurutan: ascending atau descending",
            "required": false,
            "schema": {
              "type": "string",
              "default": "asc",
              "enum": ["asc", "desc"]
            },
            "example": "asc"
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil — daftar logframe dikembalikan dalam field `data`, informasi pagination di `meta`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogframeListResponse"
                },
                "examples": {
                  "success": {
                    "summary": "Response sukses",
                    "value": {
                      "status_code": 200,
                      "message": "Success",
                      "data": [
                        {
                          "id": 1,
                          "tingkat": "Jangkauan",
                          "nama_indikator": "Jumlah petani yang didukung oleh proyek",
                          "definisi_indikator": "Jumlah petani yang tercatat dalam sistem dan mendapat manfaat program.",
                          "nilai_dasar": "0",
                          "target_pertengahan_proyek": "12.500 dengan 50% perempuan dan 20% pemuda",
                          "target_akhir_proyek": "25.000 dengan 50% perempuan dan 20% pemuda",
                          "realisasi": null,
                          "created_at": "2026-06-25",
                          "updated_at": "2026-06-25"
                        }
                      ],
                      "meta": {
                        "total": 7,
                        "limit": 5,
                        "offset": 0,
                        "order_by": "id",
                        "order_direction": "asc",
                        "search": null
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validasi gagal — parameter request tidak memenuhi aturan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                },
                "examples": {
                  "validation_error": {
                    "summary": "Parameter tidak valid",
                    "value": {
                      "status_code": 422,
                      "message": "Validasi gagal.",
                      "data": null,
                      "meta": {
                        "errors": {
                          "limit": ["The limit field must be at least 1."]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/petani": {
      "get": {
        "summary": "List Petani",
        "description": "Mengembalikan daftar data petani (`m_petani`). Mendukung pencarian, filter, pagination, dan sorting.",
        "operationId": "getPetaniList",
        "tags": ["Petani"],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Kata kunci pencarian di nama, NIK, no HP, alamat, gender, tahap, kelas lereng, dan fungsi kawasan hutan",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255,
              "nullable": true
            },
            "example": "budi"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Jumlah data per halaman (maksimum 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            },
            "example": 10
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Posisi awal data untuk pagination",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "example": 0
          },
          {
            "name": "order_by",
            "in": "query",
            "description": "Kolom pengurutan data",
            "required": false,
            "schema": {
              "type": "string",
              "default": "id",
              "enum": [
                "id",
                "nama_petani",
                "nik_petani",
                "no_hp_petani",
                "gender_petani",
                "usia_petani",
                "difabel",
                "kode_kota",
                "kode_poktan",
                "jmlah_petani",
                "luas_lahan_ha",
                "latitude",
                "longitude",
                "kelas_lereng",
                "kemiringan",
                "fungsi_kws_hutan",
                "tahap",
                "created_at",
                "updated_at"
              ]
            },
            "example": "id"
          },
          {
            "name": "order_direction",
            "in": "query",
            "description": "Arah pengurutan: ascending atau descending",
            "required": false,
            "schema": {
              "type": "string",
              "default": "asc",
              "enum": ["asc", "desc"]
            },
            "example": "asc"
          },
          {
            "name": "gender_petani",
            "in": "query",
            "description": "Filter gender petani",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["L", "P"],
              "nullable": true
            },
            "example": "P"
          },
          {
            "name": "kode_kota",
            "in": "query",
            "description": "Filter berdasarkan kode kabupaten/kota",
            "required": false,
            "schema": {
              "type": "integer",
              "nullable": true
            },
            "example": 3201
          },
          {
            "name": "kode_poktan",
            "in": "query",
            "description": "Filter berdasarkan ID kelompok tani (m_poktan)",
            "required": false,
            "schema": {
              "type": "integer",
              "nullable": true
            },
            "example": 12
          },
          {
            "name": "tahap",
            "in": "query",
            "description": "Filter berdasarkan tahap intervensi",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 50,
              "nullable": true
            },
            "example": "1"
          },
          {
            "name": "difabel",
            "in": "query",
            "description": "Filter status difabel",
            "required": false,
            "schema": {
              "type": "boolean",
              "nullable": true
            },
            "example": false
          },
          {
            "name": "dukungan_proyek",
            "in": "query",
            "description": "Filter petani dukungan proyek (`jmlah_petani = 1`)",
            "required": false,
            "schema": {
              "type": "boolean",
              "nullable": true
            },
            "example": true
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil — daftar petani dikembalikan dalam field `data`, informasi pagination di `meta`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PetaniListResponse"
                },
                "examples": {
                  "success": {
                    "summary": "Response sukses",
                    "value": {
                      "status_code": 200,
                      "message": "Success",
                      "data": [
                        {
                          "id": 1,
                          "nama_petani": "Budi Santoso",
                          "nik_petani": "3201010101010001",
                          "no_hp_petani": "081234567890",
