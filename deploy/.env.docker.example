# Salin ke .env di root folder hddap, lalu sesuaikan nilainya.
# cp .env.docker.example .env

APP_NAME=HDDAP
APP_ENV=production
APP_KEY=
APP_DEBUG=true
APP_URL=https://hddap.cloud

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database — restore manual via pgAdmin / psql (lihat hddap-new.sql)
# JANGAN pakai php artisan migrate di production Docker.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hddap
DB_USERNAME=hddap
DB_PASSWORD=hddap@2026

# Koneksi dari luar server:
# postgresql://hddap:hddap@2026@<IP-SERVER>:5432/hddap

# Port yang di-expose ke host
APP_HTTP_PORT=8080
DB_EXTERNAL_PORT=5432

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.hddap.cloud

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

STATISTIK_DASHBOARD_URL=https://datastudio.google.com/embed/u/0/reporting/5d34d483-57e4-4363-a181-6ffa335b2408/page/p_pc1cicquyd
SOCIAL_YOUTUBE_URL=https://www.youtube.com/@hddaphorti
SOCIAL_INSTAGRAM_URL=https://www.instagram.com/hddap.horti/
