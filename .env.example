APP_NAME=HDDAP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Vercel (set di Vercel Dashboard → Settings → Environment Variables)
# VERCEL=1                                    # otomatis oleh Vercel
# APP_URL=https://your-app.vercel.app
# ASSET_URL=https://your-app.vercel.app
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# STATISTIK_DASHBOARD_URL=
# SOCIAL_YOUTUBE_URL=
# SOCIAL_INSTAGRAM_URL=
#
# Video URLs — wajib di Vercel (upload ke CDN, file tidak ikut deploy)
# VIDEO_HERO_1_URL=https://your-cdn.com/hero-1.mp4
# VIDEO_HERO_2_URL=https://your-cdn.com/hero-2.mp4
# VIDEO_HERO_3_URL=https://your-cdn.com/hero-3.mp4
# VIDEO_AI_TANI_URL=https://your-cdn.com/ai-tani-menyapa.mp4

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STATISTIK_DASHBOARD_URL=https://datastudio.google.com/embed/u/0/reporting/5d34d483-57e4-4363-a181-6ffa335b2408/page/p_pc1cicquyd

SOCIAL_YOUTUBE_URL=https://www.youtube.com/@hddaphorti
SOCIAL_INSTAGRAM_URL=https://www.instagram.com/hddap.horti/
